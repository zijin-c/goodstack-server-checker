# Optional dynamic proxy. The deploy script prompts for these values when blank.
# Option A: rotating HTTP(S) gateway; provider rotates the exit IP.
GOODSTACK_PROXY_URL=

# Option B: HTTP(S) proxy-list endpoint returning text or JSON.
GOODSTACK_PROXY_LIST_URL=
GOODSTACK_PROXY_TOKEN=
GOODSTACK_PROXY_REFRESH_SECONDS=300

# The deploy script generates UI_PASSWORD if you leave it empty.
UI_PORT=8765
UI_USERNAME=admin
UI_PASSWORD=
