# Read from your Goodstack account. Keep this file private (chmod 600).
GOODSTACK_API_KEY=pk_replace_with_your_goodstack_api_key

# Option A: rotating gateway URL (provider rotates the outgoing IP per connection).
GOODSTACK_PROXY_URL=

# Option B: provider API returning HTTP(S) proxy endpoints as text or JSON.
# JSON formats supported include {"proxies":["http://host:port"]}, {"data":[...]},
# or {"data":{"ip":"host","port":8000,"username":"...","password":"..."}}.
GOODSTACK_PROXY_LIST_URL=
GOODSTACK_PROXY_TOKEN=
GOODSTACK_PROXY_REFRESH_SECONDS=300
